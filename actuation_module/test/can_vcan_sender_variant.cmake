# Writes OUT: a definition of every nros_config_variant_sz_* symbol the
# objects in OBJS reference. nros's config header anchors one in every TU
# that includes it, so a link that takes the wrong nros archive fails; the
# can_vcan_sender host program links no nros archive at all, so it defines
# the anchors itself. Run with -DNM=<nm> -DOBJS=<a;b> -DOUT=<file.c>.
set(_syms "")
foreach(_obj IN LISTS OBJS)
  execute_process(COMMAND "${NM}" -u "${_obj}"
    OUTPUT_VARIABLE _nm RESULT_VARIABLE _rc)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "nm -u ${_obj} failed (${_rc})")
  endif()
  string(REGEX MATCHALL "nros_config_variant_sz_[0-9A-Fa-f]+" _found "${_nm}")
  list(APPEND _syms ${_found})
endforeach()
list(REMOVE_DUPLICATES _syms)
set(_c "/* Generated by can_vcan_sender_variant.cmake. */\n")
foreach(_s IN LISTS _syms)
  string(APPEND _c "const unsigned char ${_s} = 0;\n")
endforeach()
file(WRITE "${OUT}.tmp" "${_c}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
