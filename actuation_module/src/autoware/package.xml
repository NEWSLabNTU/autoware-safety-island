<package format="3">
  <name>autoware_controller_libs</name>
  <version>0.1.0</version>
  <description>
    The vendored Autoware controllers of the trajectory follower (MPC
    lateral, PID longitudinal, their base classes) and the Autoware utility
    libraries they use, as one library package.
  </description>
  <maintainer email="cshih@csie.ntu.edu.tw">NEWSLab NTU</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>nros</depend>
  <depend>asi_common</depend>
  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>autoware_adapi_v1_msgs</depend>
  <depend>autoware_control_msgs</depend>
  <depend>autoware_planning_msgs</depend>
  <depend>autoware_vehicle_msgs</depend>
  <depend>tier4_debug_msgs</depend>
  <depend>visionpilot_msgs</depend>
  <depend>safety_island_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
