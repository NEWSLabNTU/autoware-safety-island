  Vendored from Autoware. The <depend>s are upstream's that exist in this
  workspace; not here: tf2, tf2_geometry_msgs; autoware_utils_geometry is
  autoware_universe_utils here.
  nros and asi_common (the logger, clock, node facade and the message
  umbrella autoware/autoware_msgs/messages.hpp) stand in for rclcpp.
-->
<package format="3">
  <name>autoware_interpolation</name>
  <version>0.1.0</version>
  <description>
    Autoware's interpolation library (linear, spline, spherical linear, 2-D
    spline points).
  </description>
  <maintainer email="cshih@csie.ntu.edu.tw">NEWSLab NTU</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>nros</depend>
  <depend>asi_common</depend>
  <depend>autoware_universe_utils</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
