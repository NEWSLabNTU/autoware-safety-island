<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!--
  Copyright (c) 2026, NEWSLab NTU.
  SPDX-License-Identifier: Apache-2.0

  Vendored from Autoware. The <depend>s are upstream's that exist in this
  workspace; not here: autoware_internal_debug_msgs,
  autoware_internal_msgs, autoware_internal_planning_msgs,
  autoware_perception_msgs, autoware_utils, diagnostic_msgs, logging_demo,
  pcl_conversions, pcl_ros, rclcpp, tf2, tf2_eigen, tf2_geometry_msgs,
  tier4_planning_msgs, unique_identifier_msgs, visualization_msgs.
  nros and asi_common (the logger, clock, node facade and the message
  umbrella autoware/autoware_msgs/messages.hpp) stand in for rclcpp.
-->
<package format="3">
  <name>autoware_universe_utils</name>
  <version>0.1.0</version>
  <description>
    Autoware's universe utilities, the geometry and math subset the
    controllers use (geometry, alt_geometry, pose_deviation, normalization,
    constants, stop_watch).
  </description>
  <maintainer email="cshih@csie.ntu.edu.tw">NEWSLab NTU</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>nros</depend>
  <depend>asi_common</depend>
  <depend>eigen</depend>
  <depend>autoware_planning_msgs</depend>
  <depend>autoware_vehicle_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>tier4_debug_msgs</depend>
  <!--
    Not upstream's: asi_common's message umbrella, which every vendored
    header includes, names these too. This package is the root of the
    vendored graph, so it generates and links them for the others.
  -->
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>autoware_adapi_v1_msgs</depend>
  <depend>autoware_control_msgs</depend>
  <depend>visionpilot_msgs</depend>
  <depend>safety_island_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
