<?xml version="1.0"?>
<!--
  Phase 2.B — ASI controller launch topology.

  ROS 2 launch XML schema, VERBATIM (nano-ros RFC-0024 §11.5). Stock
  nav2 / Autoware launch.xml pastes in and Just Works modulo unsupported
  tags. Supported here: <arg>, <node>, <param>, <remap>, $(var ...).

  This file is the declarative replacement for the imperative wiring that
  used to live in main.cpp:
    * <node name="controller">   — I2: the node name (was the
      `Node("controller", …)` ctor literal, now node_identity.hpp's
      DEFAULT_NODE_NAME, overridden here).
    * <remap from=… to=…>        — I3: the 5 subscription + 3 publisher
      topics. Every `from=` is the node's declared default (the exact
      string in controller_pkg/include/controller_pkg/node_identity.hpp);
      `to=` defaults to the same string so behaviour is UNCHANGED. The
      remap rows are the override points — edit `to=` to retopic without
      touching C++.

  2.B.2 — output-mode launch-arg surface. ASI's DDS-only / CAN-only /
  DDS+CAN selection is the `control_output` launch arg below, passed to the
  node as a param (the Kconfig choice it replaced is gone; Kconfig keeps only
  CONTROL_CMD_CAN_OUTPUT, whether the image builds a CAN backend at all). The CAN path is a hardware sink, NOT a ROS topic, so it
  is expressed as a node param rather than a <remap> (RFC workspace_mode
  open question — "the CAN path stays outside the ROS-node identity").
-->
<launch>
  <!-- 2.B.2 — output mode. Values: DDS_ONLY | CAN_ONLY | DDS_AND_CAN.
       A CAN mode needs an image built with CONFIG_CONTROL_CMD_CAN_OUTPUT. -->
  <arg name="control_output" default="DDS_ONLY"/>
  <!-- Supervision startup selection (vp_si_control_contract; the DDS build
       reads the same four from SI_* environment variables). Empty = unset:
       both supervision_mode and trajectory_source empty selects the build
       default (si / autoware); a half-set pair or an invalid value is fatal.
         supervision_mode           si | vp
         trajectory_source          autoware | vp   (vp required by mode vp)
         legacy_control_cmd         always | stop_only
         operation_mode_durability  transient_local | volatile -->
  <arg name="supervision_mode" default=""/>
  <arg name="trajectory_source" default=""/>
  <arg name="legacy_control_cmd" default=""/>
  <arg name="operation_mode_durability" default=""/>
  <!-- Vehicle and controller tuning a deployment changes (Autoware's
       sample_vehicle, upstream PID pitch limits). An [image.<id>] args table
       in system.toml binds them per image, e.g. the CARLA image
       (tesla_model3: wheel_base 3.005 m; swb's CARLA profile's PID pitch
       limits +-0.2 rad). -->
  <arg name="wheel_base" default="2.74"/>
  <arg name="max_pitch_rad" default="0.1"/>
  <arg name="min_pitch_rad" default="-0.1"/>
  <!-- Actuation profile: after (tuned, the default) | before (the CES 2026
       untuned baseline). Selects config/longitudinal/pid_profile_<p>.param.yaml. -->
  <arg name="actuation_param_profile" default="after"/>

  <node pkg="controller_pkg" exec="controller" name="controller">
    <!-- Every other parameter's value, as upstream Autoware's param files
         state them (config/). An inline <param> below wins over a file. -->
    <param from="$(dirname)/../config/trajectory_follower_node.param.yaml"/>
    <param from="$(dirname)/../config/vehicle/vehicle_info.param.yaml"/>
    <param from="$(dirname)/../config/lateral/mpc.param.yaml"/>
    <param from="$(dirname)/../config/longitudinal/pid.param.yaml"/>
    <param from="$(dirname)/../config/longitudinal/pid_profile_$(var actuation_param_profile).param.yaml"/>
    <!-- 2.B.2 — output mode flows in as a node param ($(var control_output)). -->
    <param name="control_output" value="$(var control_output)"/>
    <param name="supervision_mode" value="$(var supervision_mode)"/>
    <param name="trajectory_source" value="$(var trajectory_source)"/>
    <param name="legacy_control_cmd" value="$(var legacy_control_cmd)"/>
    <param name="operation_mode_durability" value="$(var operation_mode_durability)"/>
    <param name="wheel_base" value="$(var wheel_base)"/>
    <param name="max_pitch_rad" value="$(var max_pitch_rad)"/>
    <param name="min_pitch_rad" value="$(var min_pitch_rad)"/>

    <!-- I3 subscriptions (5) — from= MUST match node_identity.hpp exactly. -->
    <remap from="/vehicle/status/steering_status" to="/vehicle/status/steering_status"/>
    <remap from="/planning/trajectory" to="/planning/trajectory"/>
    <remap from="/localization/kinematic_state" to="/localization/kinematic_state"/>
    <remap from="/localization/acceleration" to="/localization/acceleration"/>
    <remap from="/system/operation_mode/state" to="/system/operation_mode/state"/>
    <remap from="/vehicle/driving_reference" to="/vehicle/driving_reference"/>
    <remap from="/vehicle/driving_command" to="/vehicle/driving_command"/>
    <remap from="/control/safety_island/reenable" to="/control/safety_island/reenable"/>
    <remap from="/safety_island/vp_heartbeat" to="/safety_island/vp_heartbeat"/>

    <!-- I3 publishers (3) — from= MUST match node_identity.hpp exactly. -->
    <remap from="/control/trajectory_follower/control_cmd" to="/control/trajectory_follower/control_cmd"/>
    <remap from="/control/trajectory_follower/lateral/debug/processing_time_ms" to="/control/trajectory_follower/lateral/debug/processing_time_ms"/>
    <remap from="/control/trajectory_follower/longitudinal/debug/processing_time_ms" to="/control/trajectory_follower/longitudinal/debug/processing_time_ms"/>
    <remap from="/control/safety_island/approved_request" to="/control/safety_island/approved_request"/>
  </node>
</launch>
