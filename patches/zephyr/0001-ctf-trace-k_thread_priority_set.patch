diff --git a/kernel/sched.c b/kernel/sched.c
index 2827a41fd38..57bb8dbff79 100644
--- a/kernel/sched.c
+++ b/kernel/sched.c
@@ -1042,6 +1042,12 @@ void z_impl_k_thread_priority_set(k_tid_t thread, int prio)
 
 	bool need_sched = z_thread_prio_set((struct k_thread *)thread, prio);
 
+	/* Emitted AFTER z_thread_prio_set() on purpose: the backend hook reads
+	 * thread->base.prio, so tracing before the store would record the OLD
+	 * priority and the event would be actively misleading.
+	 */
+	SYS_PORT_TRACING_OBJ_FUNC(k_thread, priority_set, thread);
+
 	if ((need_sched) && (IS_ENABLED(CONFIG_SMP) ||
 			     (_current->base.sched_locked == 0U))) {
 		z_reschedule_unlocked();
