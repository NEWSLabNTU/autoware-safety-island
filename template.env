# Copy this file to .env and fill in the values

# API settings
AVH_API_ENDPOINT=https://arm.avhstaging.corellium.com/api
AVH_API_TOKEN=#your-api-token-here

# Device settings — the dashboard's device page hands out IDs directly;
# when set they bypass the name lookups (phase-3 W3). Names remain as
# fallbacks (and are what the create-instance path uses).
AVH_PROJECT_ID=#your-project-id (dashboard: project settings)
AVH_INSTANCE_ID=#your-device-id (dashboard: device page)
AVH_PROJECT_NAME=#your-corellium-project-name (fallback when no ID)
AVH_INSTANCE_NAME=#select-a-name-for-your-instance (fallback when no ID)
AVH_INSTANCE_FLAVOR=aem8r64-lan9c111
